# =============================================================================
# ПОЛНАЯ КОНФИГУРАЦИЯ BUILDОZER ДЛЯ YTmus
# Музыкальное приложение на Kivy + KivyMD для Android
# =============================================================================

[app]

# -----------------------------------------------------------------------------
# ОСНОВНАЯ ИНФОРМАЦИЯ О ПРИЛОЖЕНИИ
# -----------------------------------------------------------------------------

# Название приложения (отображается в лаунчере Android и в заголовке)
title = YTmus

# Имя пакета (влияет на имя APK-файла и package name в Android)
# Должно быть валидным Java-идентификатором: только латиница, цифры, точки
package.name = ytmus

# Домен пакета (обычно в формате обратного домена)
# Вместе с package.name образует полный идентификатор: org.davyur.ytmus
package.domain = org.davyur

# -----------------------------------------------------------------------------
# ИСХОДНЫЙ КОД
# -----------------------------------------------------------------------------

# Директория с исходным кодом (. = текущая директория)
source.dir = .

# Расширения файлов, которые будут включены в APK
# Добавьте сюда все типы файлов, которые использует ваше приложение
source.include_exts = py,png,jpg,jpeg,kv,atlas,mp3,wav,ogg,flac,aac,json,txt,ttf,otf,md,xml

# Расширения файлов, которые НЕ будут включены (для уменьшения размера APK)
source.exclude_exts = spec,pyc,pyo,git,gitignore,md,txt

# Директории, которые нужно исключить из сборки
# source.exclude_dirs = tests, bin, venv, .git, .buildozer, __pycache__

# Глобальные паттерны исключения
# source.exclude_patterns = license, images/*/*.jpg

# -----------------------------------------------------------------------------
# ВЕРСИЯ
# -----------------------------------------------------------------------------

# Версия приложения (отображается в настройках Android)
version = 1.1.0

# Автоматическое извлечение версии из main.py (опционально)
# version.regex = __version__ = '(.*)'
# version.filename = %(source.dir)s/main.py

# Версия кода (целое число, увеличивается при каждом обновлении в Google Play)
# Если не указано — вычисляется автоматически из version
# android.numeric_version = 110

# -----------------------------------------------------------------------------
# ЗАВИСИМОСТИ (PYTHON + БИБЛИОТЕКИ)
# -----------------------------------------------------------------------------

# ВАЖНО: python3 и hostpython3 должны быть ОДНОЙ версии!
# Python 3.11.9 — стабильная комбинация с Kivy 2.3.0
# Python 3.12+ может вызвать ошибку _PyLong_AsByteArray
#
# Если хотите использовать последнюю версию Python — закомментируйте
# hostpython3==3.11.9 и python3==3.11.9, оставьте просто python3
requirements = hostpython3==3.11.9,python3==3.11.9,kivy==2.3.0,kivymd==1.2.0,mutagen,plyer,pyjnius

# Альтернативные библиотеки, которые можно добавить при необходимости:
# requests — HTTP-запросы
# Pillow — обработка изображений
# numpy — математические вычисления
# certifi, urllib3, chardet, idna — зависимости requests
# android — доступ к Android API (добавляется автоматически через bootstrap)

# -----------------------------------------------------------------------------
# ИНТЕРФЕЙС И ОРИЕНТАЦИЯ
# -----------------------------------------------------------------------------

# Ориентация экрана: portrait, landscape, all, sensor
orientation = portrait

# Полноэкранный режим: 0 = нет, 1 = да
fullscreen = 0

# -----------------------------------------------------------------------------
# ИКОНКА И ПРЕСПЛЕШ (ЗАСТАВКА)
# -----------------------------------------------------------------------------

# Иконка приложения (PNG, рекомендуется 512×512 или больше)
# Без иконки приложение может крашнуться на Android 13+!
icon.filename = icon.png

# Размер иконки (по умолчанию 512)
# icon.size = 512

# Пресплеш — картинка, показываемая при загрузке приложения
# presplash.filename = %(source.dir)s/presplash.png
# presplash.color = #ffffff
# presplash.duration = 3

# Анимированный пресплеш (Lottie) — альтернатива картинке
# presplash.lottie = %(source.dir)s/lottie_loading.json

# Цвет фона при загрузке (если нет пресплеша)
# android.presplash_color = #FFFFFF

# -----------------------------------------------------------------------------
# РАЗРЕШЕНИЯ ANDROID
# -----------------------------------------------------------------------------

# Полный список разрешений для музыкального приложения:
# INTERNET — доступ к интернету (если нужен)
# READ_EXTERNAL_STORAGE — чтение файлов (Android 12 и ниже)
# WRITE_EXTERNAL_STORAGE — запись файлов (Android 12 и ниже)
# READ_MEDIA_AUDIO — чтение аудио (Android 13+, ОБЯЗАТЕЛЬНО!)
# READ_MEDIA_IMAGES — чтение изображений (Android 13+)
# READ_MEDIA_VIDEO — чтение видео (Android 13+)
# FOREGROUND_SERVICE — фоновый сервис (для плеера)
# FOREGROUND_SERVICE_MEDIA_PLAYBACK — фоновое воспроизведение музыки
# POST_NOTIFICATIONS — отправка уведомлений (Android 13+)
# WAKE_LOCK — не давать экрану гаснуть во время воспроизведения
# VIBRATE — вибрация
# ACCESS_NETWORK_STATE — проверка состояния сети
# RECEIVE_BOOT_COMPLETED — автозапуск после перезагрузки

android.permissions = INTERNET,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE,READ_MEDIA_AUDIO,READ_MEDIA_IMAGES,READ_MEDIA_VIDEO,FOREGROUND_SERVICE,FOREGROUND_SERVICE_MEDIA_PLAYBACK,POST_NOTIFICATIONS,WAKE_LOCK,VIBRATE,ACCESS_NETWORK_STATE

# -----------------------------------------------------------------------------
# НАСТРОЙКИ ANDROID SDK / NDK
# -----------------------------------------------------------------------------

# Минимальная версия Android API (21 = Android 5.0 Lollipop)
android.minapi = 21

# Целевая версия Android API (33 = Android 13)
android.api = 33

# Версия NDK (25b — стабильная для Buildozer)
android.ndk = 25b

# Версия build-tools (33.0.2 — фикс зависания aidl)
android.sdk_build_tools = 33.0.2

# Архитектуры процессора:
# arm64-v8a — современные 64-битные телефоны (2016+)
# armeabi-v7a — старые 32-битные телефоны
# x86_64 — эмуляторы
#
# Чем больше архитектур — тем больше размер APK и дольше сборка
# Для публикации в Google Play рекомендуется только arm64-v8a
android.archs = arm64-v8a

# -----------------------------------------------------------------------------
# КАСТОМНЫЙ MANIFEST (РЕШАЕТ OnBackInvokedCallback)
# -----------------------------------------------------------------------------

# Путь к кастомному AndroidManifest (должен лежать в корне репозитория)
# Решает предупреждение "OnBackInvokedCallback is not enabled" на Android 13+
android.manifest = AndroidManifest.tmpl.xml

# -----------------------------------------------------------------------------
# ТОЧКА ВХОДА И ТЕМА
# -----------------------------------------------------------------------------

# Точка входа приложения (не менять!)
android.entrypoint = org.kivy.android.PythonActivity

# Тема Android (без заголовка — для Kivy)
android.apptheme = @android:style/Theme.NoTitleBar

# -----------------------------------------------------------------------------
# СЕРВИСЫ (ФОНОВЫЙ РЕЖИМ)
# -----------------------------------------------------------------------------

# Формат: services = имя_сервиса:путь/к/файлу.py
# Сервис работает в фоне, даже когда приложение свёрнуто
# ВАЖНО: в сервисе НЕЛЬЗЯ использовать Kivy/KivyMD — только стандартная библиотека!
#
# Для теста сервис ЗАКОММЕНТИРОВАН — раскомментируйте после проверки основного приложения
# services = myservice:service/main.py

# Несколько сервисов (через запятую):
# services = myservice:service/main.py,anotherservice:service/another.py

# -----------------------------------------------------------------------------
# ANDROIDX И СОВМЕСТИМОСТЬ
# -----------------------------------------------------------------------------

# Включить AndroidX (современные библиотеки Android)
android.enable_androidx = 1

# Копировать библиотеки в APK
android.copy_libs = 1

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ANDROID
# -----------------------------------------------------------------------------

# Режим отладки: 1 = да (больше логов), 0 = нет
android.debug = 1

# Wake lock — не давать экрану гаснуть
android.wakelock = 1

# Окно приложения (1 = да)
android.window = 1

# Место установки: auto, internalOnly, preferExternal
# android.install_location = auto

# Подпись APK (для release-сборки)
# android.keystore = %(source.dir)s/release.keystore
# android.keystore_alias = myalias
# android.keystore_password = your_password
# android.keystore_key_password = your_key_password

# Метаданные приложения (для Google Play)
# android.meta_data =

# Gradle dependencies (если нужны дополнительные библиотеки)
# android.gradle_dependencies =

# -----------------------------------------------------------------------------
# iOS НАСТРОЙКИ (если будете собирать под iOS)
# -----------------------------------------------------------------------------

# osx.python_version = 3
# osx.kivy_version = 2.3.0

# -----------------------------------------------------------------------------
# РАЗМЕР И ОПТИМИЗАЦИЯ
# -----------------------------------------------------------------------------

# Сжатие ресурсов (уменьшает размер APK)
# android.compress_assets = True

# Proguard (обфускация Java-кода, уменьшает размер)
# android.proguard_path =

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ ПРИЛОЖЕНИЯ
# -----------------------------------------------------------------------------

# Автор
# author = Your Name

# Email автора
# author.email = your@email.com

# URL приложения
# url = https://github.com/davyur/YT-mus

# Лицензия
# license = MIT

# Описание (для Google Play)
# description = Музыкальный плеер на Kivy

# -----------------------------------------------------------------------------
# ПАТЧИ И МОДИФИКАЦИИ
# -----------------------------------------------------------------------------

# Патчи для Android-кода (если нужны)
# android.patch =

# Дополнительные Java-файлы
# android.add_src =

# Дополнительные ресурсы
# android.add_resources =

# -----------------------------------------------------------------------------
# LOGS И ОТЛАДКА
# -----------------------------------------------------------------------------

# Уровень логирования: 0 = тихо, 1 = нормально, 2 = подробно
log_level = 2

# Перенаправление stdout/stderr в файл на устройстве
# android.logcat_filters = *:S python:D

# =============================================================================
# СЕКЦИЯ BUILDОZER (НАСТРОЙКИ САМОГО СБОРЩИКА)
# =============================================================================

[buildozer]

# Рабочая директория (по умолчанию .buildozer)
# build_dir = .buildozer

# Директория для bin-файлов (APK)
# bin_dir = bin

# Уровень логирования сборщика
log_level = 2

# Предупреждение при запуске от root (в Colab/GitHub Actions не актуально)
warn_on_root = 1

# Цветной вывод
# color = always

# Отслеживание изменений файлов (ускоряет повторные сборки)
# watch = 1

# =============================================================================
# КОНЕЦ КОНФИГУРАЦИИ
# =============================================================================
